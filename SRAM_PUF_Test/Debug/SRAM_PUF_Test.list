/* ------------------------------------------------------------------------ */
/* Minimal fault handlers - infinite loop so a crash is visibly stuck       */
/* rather than silently vectoring off into garbage.                        */
/* ------------------------------------------------------------------------ */
void Default_Handler(void) { while (1) { } }
